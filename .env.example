# .env.example — template committed to Git. It must NEVER contain real secrets.
# Setup: cp .env.example .env  — then fill in every empty value in .env (never committed).
# Generate a strong password with: openssl rand -hex 16
# Empty passwords are refused on purpose: "docker compose up" stops with an error.

DB_HOST=database
DB_NAME=expenses
DB_USER=app
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Code given by the church to its accountants to create an account.
# Empty = registrations closed. Generate one with: openssl rand -hex 8
REGISTRATION_CODE=
